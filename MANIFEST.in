include LICENSE
include README.md
include CHANGELOG.md
recursive-include src/grga/prompts *.txt
recursive-include src/grga/skills *
include src/grga/data/tools/README.txt

recursive-exclude src/grga/data/tools/linux-x86_64 *
recursive-exclude src/grga/data/tools/linux-aarch64 *
