{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grga.dev/schemas/trace-signals-v1.json",
  "title": "grga trace signals v1",
  "description": "Contract for the trace_signals_version + graph_actions fields emitted by `grga related --json` and `grga suggest --json`. See docs/design/trace-signals.md.",
  "type": "object",
  "required": ["trace_signals_version", "graph_actions"],
  "properties": {
    "trace_signals_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "MAJOR.MINOR contract version."
    },
    "graph_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/graph_action" }
    }
  },
  "$defs": {
    "node_id": {
      "type": "string",
      "pattern": "^(kw:|file:|head:)"
    },
    "graph_action": {
      "type": "object",
      "required": ["op", "nodes", "meta"],
      "additionalProperties": false,
      "properties": {
        "op": { "enum": ["traverse_edge", "score_node", "llm_propose"] },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node_id" }
        },
        "meta": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "const": "traverse_edge" } } },
          "then": {
            "properties": {
              "nodes": { "minItems": 2, "maxItems": 2 },
              "meta": {
                "type": "object",
                "required": ["edge_kind", "weight", "hop"],
                "properties": {
                  "edge_kind": { "type": "string" },
                  "weight": { "type": "number" },
                  "hop": { "type": "integer" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "score_node" } } },
          "then": {
            "properties": {
              "nodes": { "minItems": 1, "maxItems": 1 },
              "meta": {
                "type": "object",
                "required": ["algo", "score", "hops_from_seed"],
                "properties": {
                  "algo": { "type": "string" },
                  "score": { "type": "number" },
                  "hops_from_seed": { "type": "integer" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "llm_propose" } } },
          "then": {
            "properties": {
              "nodes": {
                "minItems": 1,
                "items": { "type": "string", "pattern": "^kw:" }
              },
              "meta": {
                "type": "object",
                "required": ["origin_query", "rationale"],
                "properties": {
                  "origin_query": { "type": "string" },
                  "rationale": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
